// B-Link tree structural invariants across all operations.
//
// Modeled for tpt-telos (QF_LRA). The node-capacity *page-fit* bound is proven
// separately by tpt-eidos (see crates/tpt-archon-verify/src/eidos.rs). Here we
// prove the *structural* property that survives every mutating operation:
//
//   After `insert`, every leaf node holds between 1 and NODE_CAPACITY keys
//   inclusive (the tree never carries an empty leaf post-split, and never
//   exceeds the node capacity), and the number of keys never decreases by more
//   than one in a single step (no key is lost except by replace).
//
// The invariant is expressed over a representative leaf `n` whose key count is
// `n.keys`, bounded by the compile-time `NODE_CAPACITY`. Insert either adds a
// new key (count grows by one) or replaces an existing key (count unchanged);
// once the node would exceed the capacity a split moves at least half the keys
// to a sibling, leaving the original node with at least 1 key and at most the
// capacity.
//
// NOTE: the verifier instantiates a type-level invariant `Leaf { keys <= C }`
// by rewriting the bare symbol `C` into a *field* access `leaf.C`, which would
// be unsound for a free constant. We therefore write the concrete bound `64`
// here and assert in the Rust harness (btree_structural_invariant_holds_across_ops)
// that `NODE_CAPACITY == 64`, so the literal and the crate constant cannot drift.

@boundary(cpu_bound)
module BTree {
    // Every leaf's key count stays within the node capacity (NODE_CAPACITY = 64).
    invariant Leaf {
        keys >= 1
        keys <= 64
    }

    // Insert a new key into a leaf that is not yet full: the count grows by one
    // and stays within capacity. A full leaf (keys == 64) takes the split path.
    func insert_new(leaf: Leaf, key: PositiveInt)
        requires leaf.keys >= 1
        requires leaf.keys <= 63
        ensures leaf.keys >= 1
        ensures leaf.keys <= 64
    {
        mutate state {
            leaf.keys += 1
        }
    }

    // Replace an existing key: the count is unchanged.
    func insert_replace(leaf: Leaf, key: PositiveInt)
        requires leaf.keys >= 1
        requires leaf.keys <= 64
        ensures leaf.keys == old(leaf.keys)
    {
        mutate state { }
    }

    // A split moves `moved >= 1` keys to a sibling, leaving the original node
    // with `keys - moved` keys. A valid split moves at most (keys - 1) keys so
    // at least one remains. We prove the original node still satisfies the
    // invariant after the split (>= 1, <= 64).
    func split(leaf: Leaf, moved: PositiveInt)
        requires leaf.keys >= 1
        requires leaf.keys <= 64
        requires moved >= 1
        requires moved <= leaf.keys - 1
        ensures leaf.keys >= 1
        ensures leaf.keys <= 64
    {
        mutate state {
            leaf.keys -= moved
        }
    }
}

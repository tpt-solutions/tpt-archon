{
  "name": "archon-db",
  "version": "0.1.0",
  "description": "Node.js bindings (napi-rs) for the tpt-archon-relational embeddable SQL engine",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tpt-solutions/tpt-archon"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "archon-db",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node smoke-test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}

# .slt corpus format (documented here once; every other file in supported/
# and divergent/ follows the same rules without repeating them):
#
#   - Lines starting with `#` are comments; blank lines separate directives.
#   - `statement ok` is followed by one non-SELECT SQL statement (DDL/DML/
#     transaction control). The runner asserts it parses AND executes
#     successfully. The statement text may span multiple lines; it ends at
#     the next blank line.
#   - `statement error <substring>` is followed by one SQL statement (any
#     kind). The runner asserts EITHER parsing OR execution fails, and that
#     `<substring>` appears in the `Debug`-formatted error. Substring match,
#     not regex. Note `ParseError`'s `Debug` prints a human-readable message
#     (e.g. `ParseError("expected FROM")`), but `DbError`'s `Debug` is a
#     plain `#[derive(Debug)]` enum dump — most variants carry no message,
#     just their PascalCase variant name plus whatever identifier caused the
#     error (e.g. `TableAlreadyExists("widgets")`), so `<substring>` patterns
#     for `DbError` cases match the variant name itself, not English prose.
#   - `query <types>` is followed by one SELECT statement, then a `----`
#     line, then the expected result rows. `<types>` is one letter per
#     output column purely for documentation/column-count sanity-checking
#     (`I` = integer, `T` = text); it does not change how comparisons are
#     done. Every expected row is on its own line; column values within a
#     row are separated by a single space, so text values used in expected
#     query output must not themselves contain whitespace.
#   - Value formatting: SQL NULL renders as the literal token `NULL`.
#     Integers render as plain decimal. Text renders as-is, unquoted.
#     Floats render via `f32::to_string`. Booleans render as Postgres's
#     text-format `t`/`f` (not `true`/`false`) — see the boolean test below
#     (formerly a gap, spec fact #9 — `Value` had no dedicated bool variant
#     and rendered `BOOLEAN` columns as plain `0`/`1`; fixed).
#   - Row order: comparison is order-INSENSITIVE (both sides are sorted
#     before comparing) unless the query text contains `ORDER BY`, in which
#     case row order must match exactly.
#   - `SELECT *` is deliberately never used in `query` blocks anywhere in
#     this corpus (supported/ or divergent/): every `CREATE TABLE` silently
#     prepends a hidden extra `id` row-id column (see divergent/known_bugs.slt,
#     "implicit id column"), so `SELECT *` after a real `CREATE TABLE`
#     returns one more leading column than the user's own schema. Using
#     explicit column lists in every `query` sidesteps that artifact instead
#     of baking it into every expected-row line. The one deliberate exception
#     is divergent/known_bugs.slt's own test of that exact behavior.
#   - No table or view column here is ever named `id` — that name is
#     reserved by the implicit row-id column, and `CREATE TABLE` rejects a
#     user column named `id` outright (see the reserved-name test below;
#     formerly a silent-data-loss bug, spec fact #1 — fixed).
#
# This file: CREATE TABLE / basic INSERT+SELECT / DROP semantics (via
# CREATE TABLE's duplicate-name check) for the DDL surface confirmed working
# in database.rs's own test module and via direct REPL testing.

statement ok
CREATE TABLE widgets (name TEXT, weight INT)

statement ok
INSERT INTO widgets (name, weight) VALUES ('bolt', 5)

statement ok
INSERT INTO widgets (name, weight) VALUES ('nut', 2)

query T
SELECT name FROM widgets WHERE weight = 5
----
bolt

query I
SELECT weight FROM widgets WHERE name = 'nut'
----
2

# CREATE TABLE of a name that already exists is an error in both engines.
# (DbError's Debug format prints the bare enum variant name, not a human
# message, for this variant — hence matching `TableAlreadyExists` rather
# than a sentence; see this file's format-convention note on Debug matching.)
statement error TableAlreadyExists
CREATE TABLE widgets (name TEXT)

# A user column literally named "id" collides with the implicit row-id
# column CREATE TABLE always prepends, so it's rejected outright (formerly
# a silent-data-loss bug — spec fact #1, moved here from
# divergent/known_bugs.slt now that it's fixed).
statement error Unsupported
CREATE TABLE reserved_id_test (id INT, v INT)

# SQL-standard doubled-quote escaping ('It''s' -> "It's") in a text literal
# (formerly broken — spec fact #6, moved here from divergent/known_bugs.slt
# now that it's fixed).
statement ok
CREATE TABLE quoting (note TEXT)

statement ok
INSERT INTO quoting (note) VALUES ('It''s')

query T
SELECT note FROM quoting
----
It's

# BOOLEAN columns store as a real Value::Bool now and render as Postgres's
# "t"/"f" text form (formerly rendered as plain "0"/"1" — spec fact #9,
# fixed). TRUE/FALSE keyword literals and the legacy 0/1-int spelling both
# work.
statement ok
CREATE TABLE flags (label TEXT, active BOOLEAN)

statement ok
INSERT INTO flags (label, active) VALUES ('a', TRUE)

statement ok
INSERT INTO flags (label, active) VALUES ('b', FALSE)

statement ok
INSERT INTO flags (label, active) VALUES ('c', 1)

query TT
SELECT label, active FROM flags WHERE active = TRUE ORDER BY label
----
a t
c t

query TT
SELECT label, active FROM flags WHERE active = FALSE ORDER BY label
----
b f

# FROM-less SELECT of pure literals (spec fact #3, partially resolved — see
# divergent/grammar_gaps.slt for what's still open): a common driver
# health-check query shape, executed directly without touching any table.
query I
SELECT 1
----
1

query TI
SELECT 'hi' AS greeting, 2 AS n
----
hi 2

# Multiple column types in one CREATE TABLE.
statement ok
CREATE TABLE gadgets (label TEXT, count INT, price INT)

statement ok
INSERT INTO gadgets (label, count, price) VALUES ('sprocket', 10, 99)

query TII
SELECT label, count, price FROM gadgets
----
sprocket 10 99

# UPDATE.
statement ok
UPDATE gadgets SET price = 79 WHERE label = 'sprocket'

query I
SELECT price FROM gadgets WHERE label = 'sprocket'
----
79

statement ok
INSERT INTO gadgets (label, count, price) VALUES ('washer', 100, 1)

# UPDATE SET only accepts a literal value (not an arbitrary expression) —
# `count = count - 1` is not supported grammar, so this uses a plain literal.
statement ok
UPDATE gadgets SET count = 99 WHERE label = 'washer'

query TI
SELECT label, count FROM gadgets WHERE label = 'washer'
----
washer 99

# DELETE.
statement ok
DELETE FROM gadgets WHERE label = 'washer'

query T
SELECT label FROM gadgets
----
sprocket

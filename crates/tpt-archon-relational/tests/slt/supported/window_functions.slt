# Window functions (Track A6): `OVER (PARTITION BY ... ORDER BY ... [ROWS
# BETWEEN ...])`, `ROW_NUMBER`/`RANK`/`DENSE_RANK`/`LAG`/`LEAD`, and
# aggregates used as window functions. See ddl.slt for the corpus format
# convention. Mirrors the patterns proven in `database/select.rs`'s own
# `window_*` test module.

statement ok
CREATE TABLE employees (dept TEXT, salary INT)

statement ok
INSERT INTO employees (dept, salary) VALUES ('eng', 100)

statement ok
INSERT INTO employees (dept, salary) VALUES ('eng', 200)

statement ok
INSERT INTO employees (dept, salary) VALUES ('eng', 200)

statement ok
INSERT INTO employees (dept, salary) VALUES ('sales', 50)

statement ok
INSERT INTO employees (dept, salary) VALUES ('sales', 150)

query TII
SELECT dept, salary, ROW_NUMBER() OVER (PARTITION BY dept ORDER BY salary DESC) AS rn FROM employees ORDER BY dept, rn
----
eng 200 1
eng 200 2
eng 100 3
sales 150 1
sales 50 2

query I
SELECT RANK() OVER (ORDER BY salary DESC) AS r FROM employees WHERE dept = 'eng' ORDER BY r
----
1
1
3

query I
SELECT DENSE_RANK() OVER (ORDER BY salary DESC) AS dr FROM employees WHERE dept = 'eng' ORDER BY dr
----
1
1
2

query II
SELECT salary, SUM(salary) OVER (PARTITION BY dept ORDER BY salary) AS running FROM employees WHERE dept = 'eng' ORDER BY salary
----
100 100
200 500
200 500

query II
SELECT salary, SUM(salary) OVER (PARTITION BY dept) AS total FROM employees WHERE dept = 'sales' ORDER BY salary
----
50 200
150 200

# Default frame is RANGE: tied ORDER BY values are grouped into a single peer,
# so the running total includes all peers of the current row.
query II
SELECT salary, SUM(salary) OVER (ORDER BY salary RANGE BETWEEN 1 PRECEDING AND CURRENT ROW) AS r FROM employees WHERE dept = 'eng' ORDER BY salary
----
100 100
200 400
200 400

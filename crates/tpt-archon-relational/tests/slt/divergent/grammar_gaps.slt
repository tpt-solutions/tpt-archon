# Known grammar gaps versus Postgres (spec facts #3, #4, #7). These are
# scope gaps in the current hand-written parser, not (necessarily) bugs —
# Track A of the wider roadmap plan is what closes them. See ddl.slt (in
# supported/) for the corpus format convention. Facts #4 and #7 are resolved
# but their tests stay here in place (not moved to supported/) rather than
# following known_bugs.slt's move-don't-edit rule — that rule is specific to
# known_bugs.slt; this file's own convention (see fact #4) is to annotate
# "(resolved)" in place instead.

statement ok
CREATE TABLE g1 (v INT)

statement ok
CREATE TABLE g2 (v INT)

# --- Fact #3 (partially resolved): FROM-less SELECT of literals now works,
# but FROM is still mandatory for anything else -----------------------------
#
# Real Postgres supports `SELECT <expr>` with no FROM (e.g. `SELECT 1`).
# A new `Statement::SelectLiteral` path (see `parser::select::
# try_parse_select_literal`) now handles the common case: a comma-separated
# list of pure literals (optionally aliased) with nothing after it —
# `SELECT 1`, `SELECT 1 AS one, 'x' AS letter` — executed directly as a
# trivial one-row result, bypassing the table/join/group-by pipeline
# entirely (see supported/ddl.slt for passing examples). This also fixed a
# real, separate, live bug it happened to share a root cause with: the
# `out-archon-pgwire` wire crate's `compat.rs` had a `SELECT <const>` health-
# check shim that called back into its own statement-normalizer on the exact
# same, unchanged text — infinite recursion (stack overflow) for every such
# query, and its generic `Passthrough` case had the identical bug for every
# OTHER statement shape too, since it never actually called the real parser.
# Both now call `tpt_archon_relational::parser::parse_statement` for real.
#
# What's NOT resolved: FROM is still unconditionally required for anything
# that isn't a pure-literal list — a bare column reference like `v` isn't a
# literal, so this still hits the old "expected FROM" parse error, not
# "unknown column" the way real Postgres would report it. General scalar
# expressions in a real table's SELECT list remain a separate, distinct gap
# (this engine's normal SELECT-list grammar still only accepts column names/
# aggregates).
statement error expected FROM
SELECT v

# --- Fact #4 (resolved): LEFT/RIGHT/FULL/CROSS JOIN now exist -------------
#
# LEFT, RIGHT, FULL, and CROSS JOIN are now supported (Track A3).
statement ok
INSERT INTO g1 (v) VALUES (1)

statement ok
INSERT INTO g2 (v) VALUES (1)

query I
SELECT v FROM g1 LEFT JOIN g2 ON v = v
----
1

query I
SELECT v FROM g1 CROSS JOIN g2
----
1

# --- Fact #7 (resolved): multi-row INSERT now exists ---------------------
#
# `InsertStatement.values` is now `Vec<Vec<Literal>>` (one entry per row),
# and `parse_insert`'s VALUES loop accepts `(...), (...), ...` — matching
# Postgres's multi-row INSERT.
statement ok
INSERT INTO g1 (v) VALUES (2), (3)

query I
SELECT v FROM g1 ORDER BY v
----
1
2
3
